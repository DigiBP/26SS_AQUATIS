<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_EvaluateSupplierResponse"
             name="Evaluate Supplier Response"
             namespace="http://camunda.org/schema/1.0/dmn">

  <decision id="EvaluateSupplierResponse" name="Evaluate supplier response">
    <decisionTable id="DecisionTable_EvaluateSupplierResponse" hitPolicy="FIRST">

      <input id="Input_Price" label="Price">
        <inputExpression id="InputExpression_Price" typeRef="number">
          <text>lastPrice</text>
        </inputExpression>
      </input>

      <input id="Input_DeliveryTime" label="Delivery Time">
        <inputExpression id="InputExpression_DeliveryTime" typeRef="number">
          <text>lastDeliveryTime</text>
        </inputExpression>
      </input>

      <input id="Input_Compliance" label="Compliance">
        <inputExpression id="InputExpression_Compliance" typeRef="string">
          <text>lastCompliance</text>
        </inputExpression>
      </input>

      <output id="Output_SupplierScore" label="Supplier Score" name="supplierScore" typeRef="number" />

      <rule id="Rule_NONE">
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"NONE"</text></inputEntry>
        <outputEntry><text>0</text></outputEntry>
      </rule>

      <!-- FULL -->
      <rule id="Rule_FULL_1"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>5 + 5 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_2"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>5 + 4 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_3"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>5 + 3 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_4"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>5 + 2 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>

      <rule id="Rule_FULL_5"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>4 + 5 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_6"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>4 + 4 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_7"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>4 + 3 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_8"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>4 + 2 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>

      <rule id="Rule_FULL_9"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>3 + 5 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_10"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>3 + 4 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_11"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>3 + 3 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_12"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>3 + 2 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>

      <rule id="Rule_FULL_13"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>2 + 5 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_14"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>2 + 4 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_15"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>2 + 3 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>
      <rule id="Rule_FULL_16"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"FULL"</text></inputEntry><outputEntry><text>2 + 2 + lastQualityScore + lastFinancialStability + 5</text></outputEntry></rule>

      <!-- PARTIAL -->
      <rule id="Rule_PARTIAL_1"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>5 + 5 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_2"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>5 + 4 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_3"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>5 + 3 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_4"><inputEntry><text>&lt;= 1000</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>5 + 2 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>

      <rule id="Rule_PARTIAL_5"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>4 + 5 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_6"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>4 + 4 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_7"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>4 + 3 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_8"><inputEntry><text>(1000..2000]</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>4 + 2 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>

      <rule id="Rule_PARTIAL_9"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>3 + 5 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_10"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>3 + 4 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_11"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>3 + 3 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_12"><inputEntry><text>(2000..3000]</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>3 + 2 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>

      <rule id="Rule_PARTIAL_13"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>&lt;= 5</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>2 + 5 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_14"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>(5..10]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>2 + 4 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_15"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>(10..15]</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>2 + 3 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>
      <rule id="Rule_PARTIAL_16"><inputEntry><text>&gt; 3000</text></inputEntry><inputEntry><text>&gt; 15</text></inputEntry><inputEntry><text>"PARTIAL"</text></inputEntry><outputEntry><text>2 + 2 + lastQualityScore + lastFinancialStability + 2</text></outputEntry></rule>

    </decisionTable>
  </decision>
</definitions>
