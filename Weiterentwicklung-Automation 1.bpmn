    <bpmn:scriptTask id="Activity_0crf978" name="Set selected supplier details" scriptFormat="javascript">
      <bpmn:incoming>Flow_02e8o5a</bpmn:incoming>
      <bpmn:outgoing>Flow_195z2th</bpmn:outgoing>
      <bpmn:script>var bestSupplier = execution.getVariable("bestSupplier");

var best = 1;

if (bestSupplier == "supplier2") {
  best = 2;
}

if (bestSupplier == "supplier3") {
  best = 3;
}

execution.setVariable("bestSupplierNumber", best);
execution.setVariable("bestSupplierScore", execution.getVariable("supplier" + best + "Score"));
execution.setVariable("bestSupplierName", execution.getVariable("supplier" + best + "Name"));
execution.setVariable("bestSupplierEmail", execution.getVariable("supplier" + best + "Email"));
execution.setVariable("bestSupplierPrice", execution.getVariable("supplier" + best + "Price"));
execution.setVariable("bestSupplierDeliveryTime", execution.getVariable("supplier" + best + "DeliveryTime"));
execution.setVariable("bestSupplierQualityScore", execution.getVariable("supplier" + best + "QualityScore"));
execution.setVariable("bestSupplierCompliance", execution.getVariable("supplier" + best + "Compliance"));
execution.setVariable("bestSupplierFinancialStability", execution.getVariable("supplier" + best + "FinancialStability"));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0uyhxsg" name="Generate contract draft">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://hook.eu1.make.com/9fcyc7qig6y0xxi18yfddl0mlk4v38gb</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="javascript">JSON.stringify({
  processInstanceId: execution.getProcessInstanceId(),
  bestSupplierName: execution.getVariable("bestSupplierName"),
  bestSupplierEmail: execution.getVariable("bestSupplierEmail"),
  bestSupplierScore: execution.getVariable("bestSupplierScore"),
  bestSupplierPrice: execution.getVariable("bestSupplierPrice"),
  bestSupplierDeliveryTime: execution.getVariable("bestSupplierDeliveryTime"),
  productDescriptions: execution.getVariable("productDescriptions"),
  quantity: execution.getVariable("quantity"),
  deliveryDate: execution.getVariable("deliveryDate")
})</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:script scriptFormat="javascript">var headers = new java.util.HashMap();
headers.put("Content-Type", "application/json");
headers;</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
