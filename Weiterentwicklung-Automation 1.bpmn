    <bpmn:scriptTask id="Activity_0vvyouu" name="Set expected responses" scriptFormat="javascript">
      <bpmn:incoming>Flow_0qf6wul</bpmn:incoming>
      <bpmn:outgoing>Flow_0ngm5y6</bpmn:outgoing>
      <bpmn:script>var expected = 0;

if (execution.getVariable("supplier1Email") != null &amp;&amp; execution.getVariable("supplier1Email") != "") {
  expected++;
}

if (execution.getVariable("supplier2Email") != null &amp;&amp; execution.getVariable("supplier2Email") != "") {
  expected++;
}

if (execution.getVariable("supplier3Email") != null &amp;&amp; execution.getVariable("supplier3Email") != "") {
  expected++;
}

execution.setVariable("expectedResponses", expected);
execution.setVariable("receivedResponses", 0);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_17uxlck" name="no" sourceRef="Gateway_1g40hxd" targetRef="supplierResponseReceived">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${receivedResponses &lt; expectedResponses}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
