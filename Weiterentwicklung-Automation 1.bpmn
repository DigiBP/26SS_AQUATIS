    <bpmn:intermediateCatchEvent id="contractDraftGenerated" name="Wait for contract draft">
      <bpmn:incoming>Flow_1smyyok</bpmn:incoming>
      <bpmn:outgoing>Flow_19u0mgr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_139hni1" messageRef="Message_3255fkj" />
    </bpmn:intermediateCatchEvent>
