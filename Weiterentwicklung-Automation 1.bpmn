    <bpmn:sequenceFlow id="Flow_06enmmj" name="yes" sourceRef="Gateway_1g40hxd" targetRef="Activity_0do1oe0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${receivedResponses &gt;= expectedResponses}</bpmn:conditionExpression>
