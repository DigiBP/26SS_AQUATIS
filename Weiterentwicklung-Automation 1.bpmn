    <bpmn:serviceTask id="Activity_1la3vnr" name="Send RFQs to all suppliers">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://hook.eu1.make.com/470t0bidw5cisrtr28ljkq04denmtxad</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="javascript">JSON.stringify({
  processInstanceId: execution.getProcessInstanceId(),

  supplier1Name: execution.getVariable("supplier1Name"),
  supplier1Email: execution.getVariable("supplier1Email"),

  supplier2Name: execution.getVariable("supplier2Name"),
  supplier2Email: execution.getVariable("supplier2Email"),

  supplier3Name: execution.getVariable("supplier3Name"),
  supplier3Email: execution.getVariable("supplier3Email"),

  requirementDescription: execution.getVariable("requirementDescription"),
  technicalSpecifications: execution.getVariable("technicalSpecifications"),
  quantity: execution.getVariable("quantity"),
  deliveryDate: execution.getVariable("deliveryDate")
})</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:script scriptFormat="javascript">var headers = new java.util.HashMap();
headers.put("Content-Type", "application/json");
headers;</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ngm5y6</bpmn:incoming>
      <bpmn:outgoing>Flow_1e26jgc</bpmn:outgoing>
    </bpmn:serviceTask>
