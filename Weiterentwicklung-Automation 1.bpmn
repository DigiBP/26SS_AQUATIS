    <bpmn:scriptTask id="Activity_14ors8v" name="Store supplier response" scriptFormat="javascript">
      <bpmn:incoming>Flow_08cqk2t</bpmn:incoming>
      <bpmn:outgoing>Flow_1qssb69</bpmn:outgoing>
      <bpmn:script>var count = execution.getVariable("receivedResponses");

if (count == null) {
  count = 0;
}

count = count + 1;
execution.setVariable("receivedResponses", count);

var supplierNumber = Number(execution.getVariable("lastSupplierNumber"));
var compliance = String(execution.getVariable("lastCompliance")).toUpperCase();

execution.setVariable("supplier" + supplierNumber + "Name", execution.getVariable("lastSupplierName"));
execution.setVariable("supplier" + supplierNumber + "Email", execution.getVariable("lastSupplierEmail"));
execution.setVariable("supplier" + supplierNumber + "Price", Number(execution.getVariable("lastPrice")));
execution.setVariable("supplier" + supplierNumber + "DeliveryTime", Number(execution.getVariable("lastDeliveryTime")));
execution.setVariable("supplier" + supplierNumber + "QualityScore", Number(execution.getVariable("lastQualityScore")));
execution.setVariable("supplier" + supplierNumber + "Compliance", compliance);
execution.setVariable("supplier" + supplierNumber + "FinancialStability", Number(execution.getVariable("lastFinancialStability")));
execution.setVariable("supplier" + supplierNumber + "Score", Number(execution.getVariable("supplierScore")));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="EvaluateSupplierResponse" name="Evaluate supplier response" camunda:resultVariable="supplierScore" camunda:decisionRef="EvaluateSupplierResponse" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0bms4f2</bpmn:incoming>
      <bpmn:outgoing>Flow_08cqk2t</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0bms4f2" sourceRef="Activity_02h96rp" targetRef="EvaluateSupplierResponse" />
    <bpmn:scriptTask id="Activity_02h96rp" name="Prepare supplier score input" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0u7qhhf</bpmn:incoming>
      <bpmn:outgoing>Flow_0bms4f2</bpmn:outgoing>
      <bpmn:script>execution.setVariable("lastPrice", Number(execution.getVariable("lastPrice")));
execution.setVariable("lastDeliveryTime", Number(execution.getVariable("lastDeliveryTime")));
execution.setVariable("lastQualityScore", Number(execution.getVariable("lastQualityScore")));
execution.setVariable("lastFinancialStability", Number(execution.getVariable("lastFinancialStability")));

execution.setVariable(
  "lastCompliance",
  String(execution.getVariable("lastCompliance")).toUpperCase()
);</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>
